# App
NODE_ENV=development
APP_URL=http://localhost:3033
AUTH_SECRET=generate_secret_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3033
NEXTAUTH_SECRET=generate_secret_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3033

# MariaDB / MySQL
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://baixe:baixe@127.0.0.1:3306/quan_ly_bai_xe"

# Redis (OTP, rate limit, BullMQ). Để trống thì OTP/rate-limit dùng bộ nhớ tạm.
REDIS_URL="redis://127.0.0.1:6379"

# SMTP — để trống thì mã OTP in ra màn hình / console khi dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sổ bãi xe <noreply@localhost>"

# SMS cho khách (không điền thì tin chỉ ghi sổ, chưa nhắn ra máy)
# speedsms | esms | twilio | log
SMS_PROVIDER=log
SMS_ACCESS_TOKEN=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRAND=
SMS_TYPE=2
SMS_SANDBOX=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# VietQR nhận tiền gói SaaS (admin duyệt tay hoặc webhook tự khớp)
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME="MB Bank"
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME="CONG TY SO BAI XE"
# Khóa webhook SePay/PayOS. Trống thì chỉ cho phép khi không phải production.
SEPAY_WEBHOOK_KEY=
# 1 = máy dev tự duyệt ngay khi tạo QR (không dùng production)
SAAS_AUTO_APPROVE=0

# AI Vision: Nhận diện biển số xe bằng Google Gemini API (Tuỳ chọn - Tự động fallback sang OCR cục bộ nếu trống)
GEMINI_API_KEY=

